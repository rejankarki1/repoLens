# Local development only. Copy this file to .env before starting Compose.
POSTGRES_USER=repolens
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=repolens
POSTGRES_PORT=5433
REDIS_PORT=6379

# The API runs on your host, so these URLs use 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://repolens:local_dev_password@127.0.0.1:5433/repolens
REDIS_URL=redis://127.0.0.1:6379/0
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Sign in with GitHub (see README "GitHub OAuth App setup"). Create an OAuth App, then set these in .env; never commit them.
# Use `localhost` for both URLs locally: the session cookie only works when the web app and the API are on the same site.
WEB_BASE_URL=http://localhost:3000           # where the browser returns after sign-in (must be one of WEB_ORIGINS)
API_PUBLIC_URL=http://localhost:8765         # the OAuth callback is <API_PUBLIC_URL>/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=                # a secret: .env only
# ENVIRONMENT=production                     # in production: Secure __Host- cookies, HSTS, docs off, unsafe config refused at start-up
# SESSION_TTL_SECONDS=1209600                # absolute session lifetime (14 days); SESSION_IDLE_SECONDS=604800 (7 days idle)

# Repositories (owner/name, comma separated) that visitors may browse read-only without signing in. Nothing is public unless listed.
# GUEST_SHOWCASE_REPOSITORIES=pallets/itsdangerous

# --- Usage limits (all enforced server-side in Redis; the values shown are the defaults)
# AI_DAILY_LIMIT_PER_USER=20                 # questions per user per 24 h; refunded when no answer is saved
# AI_BURST_LIMIT=5                           # questions per user per AI_BURST_WINDOW_SECONDS=60; counts every attempt
# AI_GLOBAL_DAILY_LIMIT=500                  # all users together per 24 h: the provider budget guard
# AI_GLOBAL_CONCURRENCY=8                    # answers generated at the same moment
# IMPORT_HOURLY_LIMIT=10                     # new imports / re-ingestions per user per hour
# IMPORT_MAX_CONCURRENT_PER_USER=3           # repositories being ingested at once per user
# MAX_REPOSITORIES_PER_USER=50
# EMBEDDING_BUILD_HOURLY_LIMIT=6
# EMBEDDING_MAX_CHUNKS_PER_REPOSITORY=10000  # most chunks embedded per repository (code default). Production (Render free tier) uses 3000: set it in the Render dashboard.
# ARCHITECTURE_HOURLY_LIMIT=30
# GUEST_READS_PER_MINUTE=120                 # per client IP, signed-out requests
# AUTH_LOGIN_PER_MINUTE=20                   # per client IP, starting/finishing sign-in
# TRUSTED_PROXIES=10.0.0.0/8                 # reverse proxies whose X-Forwarded-For is believed; empty = never

# Optional: a GitHub personal access token for outbound API calls.
# Raises the rate limit from 60/hr (unauthenticated) to 5000/hr. Leave unset for local dev.
# GITHUB_TOKEN=

# Optional: semantic code search (docs/search.md), using Google's gemini-embedding-001. Without a key, search
# is keyword-only and everything else works. Create a key in Google AI Studio and set it in .env, never commit it.
# GEMINI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_GENERATION_MODEL=gemini-3.5-flash  # answers for repository questions; uses GEMINI_API_KEY
# Answer provider: gemini (default) or groq. Embeddings always use Gemini. There is no automatic fallback.
# GENERATION_PROVIDER=groq
# GROQ_API_KEY=                                # from console.groq.com; never commit it
# GROQ_GENERATION_MODEL=llama-3.3-70b-versatile
# Overrides GENERATION_PROVIDER for Architecture Diagram generation only (Ask AI is unaffected); unset means
# "same as GENERATION_PROVIDER". A diagram prompt is much larger than a chat answer, so this is useful when
# GENERATION_PROVIDER=groq but the chosen Groq model's per-request size limit is too small for a diagram.
# ARCHITECTURE_DIAGRAM_GENERATION_PROVIDER=gemini

# Architecture analysis (docs/architecture.md) is deterministic and needs no API key. Most code files analyzed per repository.
# ARCHITECTURE_MAX_FILES=5000

# Everything else (timeouts, size limits, retrieval and retry settings) has a working default; see apps/api/config.py.
# The background worker (python -m apps.api.worker) reads this same file. Never put real keys in this example file.

# --- Hosted deployment (Render + Vercel + Neon + Redis): see docs/deployment.md. Local development ignores all of this.
# DATABASE_URL accepts a provider-style URL (postgresql://...?sslmode=require); it is converted for asyncpg automatically.
# IMPORT_GLOBAL_DAILY_LIMIT=0                # new imports across ALL users per 24 h; 0 = unlimited (the default)
# MAX_TOTAL_REPOSITORIES=0                   # most repositories stored in total; 0 = unlimited (the default)
# Web app (Vercel): NEXT_PUBLIC_API_URL=/api and API_ORIGIN=https://<service>.onrender.com make the browser use one origin.

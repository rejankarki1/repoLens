# Local development only. Copy this file to .env before starting Compose.
POSTGRES_USER=repolens
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=repolens
POSTGRES_PORT=5433
REDIS_PORT=6379

# The API runs on your host, so these URLs use 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://repolens:local_dev_password@127.0.0.1:5433/repolens
REDIS_URL=redis://127.0.0.1:6379/0
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: a GitHub personal access token for outbound API calls.
# Raises the rate limit from 60/hr (unauthenticated) to 5000/hr. Leave unset for local dev.
# GITHUB_TOKEN=

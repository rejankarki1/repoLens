# Overlay for the isolated OAuth-check stack. Copy to .env.oauth-check, chmod 600, fill in the two credentials.
#
# Two-file model (see README "Start and stop"):
#   .env              the shared base: Docker ports, GEMINI_API_KEY, GROQ_API_KEY, models, GENERATION_PROVIDER ...
#   .env.oauth-check  THIS file: only what differs for the isolated run. apps/api/config.py reads .env and then
#                     this file, so plain uvicorn / worker commands pick it up; values here win. Do NOT put AI keys here (they would shadow .env) and do not add blank
#                     "override" lines: they are not needed, and editors tend to strip them.
#
# Never commit the real file (it is git-ignored) and never paste its contents anywhere.

# A copy of your development data (docs/oauth-verification.md, step 4), never the real database
DATABASE_URL=postgresql+asyncpg://repolens:local_dev_password@127.0.0.1:5433/repolens_oauth_check

# Separate Redis database and queue: your real `ingestion` queue is never used
REDIS_URL=redis://127.0.0.1:6379/8
INGESTION_QUEUE_NAME=oauth_check

# GitHub OAuth App (callback must be exactly http://localhost:8765/auth/github/callback)
GITHUB_OAUTH_CLIENT_ID=PASTE_MY_CLIENT_ID_HERE
GITHUB_OAUTH_CLIENT_SECRET=PASTE_MY_CLIENT_SECRET_HERE

# Use `localhost` everywhere (not 127.0.0.1): the session cookie needs the web app and the API on one site
WEB_BASE_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8765

# Repositories visitors may browse read-only without signing in
GUEST_SHOWCASE_REPOSITORIES=pallets/itsdangerous
